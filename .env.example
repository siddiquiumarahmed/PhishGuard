# PhishGuard local configuration. Copy to .env and adjust:
#   Copy-Item .env.example .env        (PowerShell)
# Never commit a populated .env file. Every value below is optional.

# --- Flask ---------------------------------------------------------------
# Signs session cookies. If empty, a random key is generated once and stored in
# instance/secret_key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true only if you serve PhishGuard over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Database ------------------------------------------------------------
# Default: SQLite file at instance/phishguard.db
# PostgreSQL example (requires: pip install "psycopg[binary]"):
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/phishguard
DATABASE_URL=

# --- Scanner -------------------------------------------------------------
# Maximum accepted URL length in characters (64-8192).
MAX_URL_LENGTH=2048
# Days before scan records are deleted automatically (1-365).
SCAN_RETENTION_DAYS=7
# Also store the normalised URL (no credentials/fragment) in the database.
STORE_NORMALIZED_URL=false
# Report "Inconclusive" instead of "No threat detected" unless at least one
# threat-intelligence lookup completed.
REQUIRE_REPUTATION_FOR_CLEAN=false

# --- Threat intelligence (optional; check each provider's terms) ---------
# Google Safe Browsing Lookup API v4 - non-commercial use.
GOOGLE_SAFE_BROWSING_API_KEY=
# Google Web Risk - commercial use, billing-enabled Google Cloud project.
GOOGLE_WEB_RISK_API_KEY=
# PhishTank checkurl API. The app key is optional but raises rate limits.
PHISHTANK_ENABLED=false
PHISHTANK_API_KEY=
PHISHTANK_USERNAME=
# Network timeouts (seconds) and cache lifetime for lookups.
INTEL_CONNECT_TIMEOUT=3.05
INTEL_READ_TIMEOUT=6
INTEL_CACHE_TTL_SECONDS=1800

# --- Machine learning (optional) -----------------------------------------
# Path to a model produced by scripts/train_model.py (relative to the project root).
# Example: ML_MODEL_PATH=ml_artifacts/pg-randomforest-20261020120000.joblib
ML_MODEL_PATH=
ML_ENABLED=true

# --- Rate limiting -------------------------------------------------------
RATELIMIT_ENABLED=true
SCAN_RATE_LIMIT=20 per minute;300 per day
RATELIMIT_DEFAULT=200 per minute;5000 per hour

# --- Logging -------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. Submitted URLs are never logged.
LOG_LEVEL=INFO
